#!/bin/zsh
# Bookbind -- starts the local server, opens the page, and stays alive so quitting
# this app from the Dock shuts the server down with it.
HERE="$(cd "$(dirname "$0")" && pwd)"                      # Bookbind.app/Contents/MacOS
RES="$(cd "$HERE/../Resources" 2>/dev/null && pwd)"

# A released copy carries the server inside the bundle; a checkout keeps it in the
# folder beside the .app, which is where it gets edited.
if [[ -f "$RES/app.py" ]]; then
  APP="$RES"
else
  APP="$(cd "$HERE/../../.." && pwd)"
fi
cd "$APP" || exit 1

# Finder hands a launched app a bare PATH, so the Homebrew prefixes have to be
# added by hand or python3 and ffmpeg are invisible to us.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

PORT=8765
URL="http://127.0.0.1:$PORT"
LOG="$HOME/Library/Logs/Bookbind/Bookbind.log"
mkdir -p "${LOG:h}"

bail() {
  osascript -e "display alert \"Bookbind could not start\" message \"$1\" as critical"
  exit 1
}

if curl -s -o /dev/null --max-time 1 "$URL/api/home"; then
  open "$URL"                                      # already running: just show it
  exit 0
fi

# A self-contained build carries its own Python and ffmpeg under Resources/bin and
# needs nothing installed; a lightweight copy runs the server with the Homebrew ones.
SELF="$RES/bin/BookbindServer"
if [[ -x "$SELF" ]]; then
  export PATH="$RES/bin:$PATH"
  command -v ffmpeg >/dev/null 2>&1 && command -v ffprobe >/dev/null 2>&1 \
    || bail "The ffmpeg bundled with Bookbind is missing.\\n\\nDownload the app again."
  RUN=("$SELF")
else
  [[ -f "$APP/app.py" ]] || bail "The server file is missing from this copy of Bookbind."

  # An interpreter that can actually see mutagen is the only one worth starting
  PY=""
  for c in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import mutagen' >/dev/null 2>&1; then
      PY="$c"
      break
    fi
  done
  [[ -n "$PY" ]] || bail "Bookbind needs Python 3 with the mutagen module.\\n\\nRun:\\n  brew install python3\\n  python3 -m pip install mutagen"

  command -v ffmpeg >/dev/null 2>&1 && command -v ffprobe >/dev/null 2>&1 \
    || bail "Bookbind needs ffmpeg.\\n\\nRun:\\n  brew install ffmpeg"

  RUN=("$PY" "$APP/app.py")
fi

"${RUN[@]}" >>"$LOG" 2>&1 &
SERVER=$!
trap 'kill $SERVER 2>/dev/null' EXIT INT TERM

for i in {1..40}; do
  curl -s -o /dev/null --max-time 1 "$URL/api/home" && break
  kill -0 $SERVER 2>/dev/null || bail "The server stopped on startup.\\n\\nSee $LOG"
  sleep 0.25
done

open "$URL"
wait $SERVER
